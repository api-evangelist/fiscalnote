          "id": "d98a1b32-6371-429b-be65-a91b64528c70",
          "name": "FiscalNote List presidential transcripts",
          "request": {
            "name": "FiscalNote List presidential transcripts",
            "description": {
              "content": "Returns a paginated list of presidential transcripts including executive orders, proclamations, press statements, and public remarks. This feed delivers primary-source, verified transcripts purpose-built for programmatic consumption to eliminate AI hallucinations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "policynote",
                "v1",
                "transcripts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by transcript type such as executive_order, proclamation, press_statement, or public_remarks."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Full-text search query to filter results."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Maximum number of results to return per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "updatedSince",
                  "value": "<dateTime>",
                  "description": "Return only records updated after this ISO 8601 datetime."
                },
                {
                  "disabled": false,
                  "key": "dateFrom",
                  "value": "<date>",
                  "description": "Filter transcripts from this date onward in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "dateTo",
                  "value": "<date>",
                  "description": "Filter transcripts up to this date in ISO 8601 format."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
