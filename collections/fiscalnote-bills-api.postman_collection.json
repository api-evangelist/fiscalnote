          "name": "FiscalNote List bills",
          "request": {
            "name": "FiscalNote List bills",
            "description": {
              "content": "Returns a paginated list of bills and legislative measures. Supports filtering by jurisdiction, session, status, keyword search, and other criteria. Results include both current and historical legislation from the US and international jurisdictions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "appdata",
                "v1",
                "bills"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "jurisdiction",
                  "value": "<string>",
                  "description": "Filter by jurisdiction code such as US, US-CA, GB, or EU."
                },
                {
                  "disabled": false,
                  "key": "session",
                  "value": "<string>",
                  "description": "Filter by legislative session identifier."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by legislation status."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Full-text search query to filter results."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Maximum number of results to return per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "updatedSince",
                  "value": "<dateTime>",
                  "description": "Return only records updated after this ISO 8601 datetime."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
